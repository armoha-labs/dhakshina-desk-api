# Copy to .env for local runs. Never commit real values.

# MongoDB. Production: the same Atlas cluster as Yummverse, set only through the
# host's secret store. Development: a local replica set.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# The database follows APP_ENV: dhakshina_desk in production, dhakshinadeskdev
# otherwise. Set this only to override that.
MONGODB_DB=
# Optional: a database user for the admin console that can read only
# tenants, plans, subscriptions, invoices, usage_counters and audit_log
# (plus insert on audit_log and update on tenants).
MONGODB_ADMIN_URI=

# "production" in production. Anything else returns dev_code on OTP start.
APP_ENV=development
# ROLE: api, worker or all (one process at launch).
ROLE=all
PORT=8080

# Where the website lives (links in WhatsApp point here) and this API's own
# public origin (gateway notify URL, mock pay).
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Secrets: generate each with `openssl rand -base64 32`. Reuse the values the
# Next.js server had for JWT_SECRET, LINK_SECRET and FIELD_ENC_KEY so tokens,
# links already sent and encrypted phone numbers keep working.
JWT_SECRET=
LINK_SECRET=
FIELD_ENC_KEY=
ADMIN_TOKEN_SECRET=

# Platform admin: comma-separated email=hash pairs. Make a hash with
#   go run ./cmd/dhakshina admin-hash 'a long password'
ADMIN_USERS=

# Subscription gateway: mock | razorpay | cashfree (mock is refused in production).
# Used until a platform admin saves Payment settings in the admin console;
# from then on the saved settings win. Production can start with
# PAYMENT_GATEWAY=razorpay and empty keys, and the keys added in the console.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# WhatsApp Cloud API. Leave the token empty to log sends instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
